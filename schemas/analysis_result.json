{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-constrained analysis",
  "type": "object",
  "required": [
    "summary",
    "findings",
    "limitations",
    "response_options"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "response_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "evidence_ids",
          "record_ids"
        ],
        "properties": {
          "statement": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "record_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}